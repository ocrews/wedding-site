# Local development only. Copy to .env (gitignored). Never put real values in this file.
# Staging/prod values live in GitHub Environments.

NODE_ENV=development
LOG_LEVEL=info

# Postgres (compose service "postgres")
POSTGRES_USER=wedding
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_DB=wedding
DATABASE_URL=postgres://wedding:change-me-local-only@postgres:5432/wedding

# Redis (compose service "redis")
REDIS_URL=redis://redis:6379

# Public origin of the site. Real domain is a GitHub Environment variable, never committed.
SITE_URL=http://localhost:3000
API_URL=http://api:4000
