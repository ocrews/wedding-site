# ---------------------------------------------------------------------------
# PRIVACY RULE: nothing real about the wedding goes in git.
# Exports, dumps, and data files are ignored wholesale. See CLAUDE.md.
# ---------------------------------------------------------------------------
*.csv
*.tsv
*.xlsx
*.pdf
*.dump
*.sql
*.sql.gz
data/
exports/
codes/
backups/

# Env / secrets
.env
.env.*
!.env.example
*.pem
*.key
*.p12
secrets/

# Terraform state (PR2+)
*.tfstate
*.tfstate.*
.terraform/
*.tfvars
!*.tfvars.example

# Dependencies
node_modules/
.pnpm-store/

# Build output / caches
dist/
.next/
out/
.turbo/
coverage/
