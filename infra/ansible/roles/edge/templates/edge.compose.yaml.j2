# Managed by Ansible (roles/edge). Edge stack: Cloudflare Tunnel → Caddy → app containers.
# No ports are published on the host; cloudflared connects outbound to Cloudflare.
name: edge

services:
  # Read-only, filtered Docker API so Caddy can discover routes without holding the raw socket.
  socket-proxy:
    image: {{ edge_images.socket_proxy }}
    environment:
      CONTAINERS: 1
      NETWORKS: 1
      EVENTS: 1
      INFO: 1
      POST: 0
    volumes:
      - /var/run/docker.sock:/var/run/docker.sock:ro
    networks: [socket]
    restart: unless-stopped

  # Routes by Host header using labels on app containers (see deploy/compose.app.yaml).
  # TLS terminates at Cloudflare; the tunnel speaks plain HTTP to Caddy inside the host.
  caddy:
    image: {{ edge_images.caddy }}
    environment:
      CADDY_INGRESS_NETWORKS: edge
      DOCKER_HOST: tcp://socket-proxy:2375
    labels:
      caddy.auto_https: "off"
      caddy.servers.trusted_proxies: static private_ranges
    volumes:
      - caddy_data:/data
    networks: [edge, socket]
    depends_on: [socket-proxy]
    restart: unless-stopped

  cloudflared:
    image: {{ edge_images.cloudflared }}
    command: tunnel --no-autoupdate --metrics 0.0.0.0:2000 run
    environment:
      TUNNEL_TOKEN: ${TUNNEL_TOKEN}
    networks: [edge]
    depends_on: [caddy]
    restart: unless-stopped

networks:
  edge:
    name: edge
  socket:
    internal: true

volumes:
  caddy_data:
